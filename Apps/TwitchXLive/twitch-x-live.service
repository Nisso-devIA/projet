[Unit]
Description=Twitch → X live notifier (zaeldryk)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/TwitchXLive
ExecStart=/opt/TwitchXLive/.venv/bin/python /opt/TwitchXLive/notifier.py
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
