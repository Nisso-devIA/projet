# Copier vers .env puis chmod 600. Ne jamais commiter .env.

# Application sur https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Compte bot dédié (pas le compte zaeldryk). Remplis par scripts/get_token.py
TWITCH_BOT_LOGIN=
TWITCH_BOT_USER_ID=
TWITCH_BOT_ACCESS_TOKEN=
TWITCH_BOT_REFRESH_TOKEN=

# Chaîne à rejoindre
TWITCH_CHANNEL=zaeldryk
TWITCH_BROADCASTER_ID=426411773

# Relais TikTok Live. 0 = éteint jusqu'à !relais on
TIKTOK_UNIQUE_ID=zaeldryk
TIKTOK_RELAY=0

# Jeton du compte zaeldryk, pas du bot. Scopes : clips:edit channel:manage:predictions channel:manage:polls
# python3 scripts/get_token.py --flow code --who broadcaster
TWITCH_BROADCASTER_ACCESS_TOKEN=
TWITCH_BROADCASTER_REFRESH_TOKEN=

# Webhook du salon 🎬-clips uniquement. Ne pas utiliser le salon 𝕋-twitch. Vide = pas de message Discord.
DISCORD_CLIPS_WEBHOOK_URL=

# Récap de fin de live. Le webhook doit viser 📝-résumé, pas 📢-annonces et pas une annonce de début de live.
DISCORD_RECAP_WEBHOOK_URL=
DISCORD_RECAP_CHANNEL_ID=1570024936565899357

# Premier message d'un viewer. L'écart évite qu'un raid noie le chat.
DISCORD_INVITE_URL=https://discord.gg/3vH2u7pme5
FIRST_WELCOME_GAP_SECONDS=12

LOG_LEVEL=INFO
