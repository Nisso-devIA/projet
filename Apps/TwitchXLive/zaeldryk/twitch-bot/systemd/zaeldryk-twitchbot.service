[Unit]
Description=Bot Twitch Zaeldryk (chat, modération, EventSub)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/zaeldryk/twitch-bot
EnvironmentFile=/home/ubuntu/zaeldryk/twitch-bot/.env
ExecStart=/usr/bin/python3 -m zaelbot
Restart=always
RestartSec=15

[Install]
WantedBy=multi-user.target
