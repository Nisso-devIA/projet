[Unit]
Description=Upload Zaeldryk Twitch VODs to Google Drive

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/zaeldryk
Environment=ZAEL_ROOT=/home/ubuntu/zaeldryk
ExecStart=/usr/bin/python3 -u /home/ubuntu/zaeldryk/tools/drive-vods.py
Restart=on-failure
RestartSec=120

[Install]
WantedBy=multi-user.target
