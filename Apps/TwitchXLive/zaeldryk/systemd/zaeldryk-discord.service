[Unit]
Description=ZAELDRYK Discord Bot (Verification + Logs + Welcome)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu
ExecStart=/usr/bin/python3 /home/ubuntu/zaeldryk/discord/zaeldryk-discord-bot.py
Restart=always
RestartSec=10
StandardOutput=append:/home/ubuntu/zaeldryk/logs/discord-bot.log
StandardError=append:/home/ubuntu/zaeldryk/logs/discord-bot.log

[Install]
WantedBy=multi-user.target
