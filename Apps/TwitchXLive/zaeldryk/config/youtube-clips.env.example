# Enable enqueue from live-orchestrator (1/0)
YOUTUBE_CLIPS_ENABLED=1

# Dry-run: render files, skip YouTube upload
YOUTUBE_CLIPS_DRY_RUN=0

# Skip titles (case-insensitive regex). Keep single quotes for bash + Python.
YOUTUBE_CLIPS_SKIP_TITLE_PATTERN='ending|offline|test|\bend\b'

# Twitch (defaults come from twitch.env if unset)
# TWITCH_CLIENT_ID=
# TWITCH_BROADCASTER_ID=426411773
# TWITCH_LOGIN=zaeldryk
# TWITCH_TOKEN_FILE=/home/ubuntu/twitch_token.txt

# YouTube OAuth token file (from tools/youtube-oauth-setup.py)
YOUTUBE_OAUTH_FILE=/home/ubuntu/zaeldryk/config/youtube-oauth.json
YOUTUBE_CLIENT_SECRETS=/home/ubuntu/zaeldryk/config/twitch-youtube.json
YOUTUBE_PRIVACY=public
YOUTUBE_CATEGORY_ID=20

# Pipeline
YOUTUBE_CLIPS_SHORT_COUNT=5
YOUTUBE_CLIPS_SHORT_SECONDS=40
YOUTUBE_CLIPS_CLASSIC_TARGET_SECONDS=720
YOUTUBE_CLIPS_CLASSIC_MIN_SECONDS=600
YOUTUBE_CLIPS_CLASSIC_MAX_SECONDS=900
YOUTUBE_CLIPS_SEGMENT_SECONDS=35
YOUTUBE_CLIPS_VOD_HEIGHT=720
YOUTUBE_CLIPS_VOD_WAIT_SECONDS=7200
YOUTUBE_CLIPS_MUSIC_VOLUME=0.16
YOUTUBE_CLIPS_TWITCH_URL=https://www.twitch.tv/zaeldryk

# Paths (optional overrides)
# YOUTUBE_CLIPS_WORK_DIR=/home/ubuntu/zaeldryk/youtube-clips/work
# YOUTUBE_CLIPS_MUSIC_DIR=/home/ubuntu/zaeldryk/youtube-clips/music
# YOUTUBE_CLIPS_DB=/home/ubuntu/zaeldryk/state/youtube-clips.sqlite
