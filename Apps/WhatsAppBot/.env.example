# Numéro WhatsApp du propriétaire (indicatif pays, sans + ni espaces)
# Reçoit les alertes quand le bot est KO
# Exemple France : 33612345678
OWNER_NUMBER=

# Clé CallMeBot pour t'alerter sur WhatsApp même quand le bot est mort
# 1) Ajoute +34 644 60 67 38 sur WhatsApp
# 2) Envoie "I allow callmebot to send me messages"
# 3) Récupère ta clé sur https://www.callmebot.com/blog/free-api-whatsapp-messages/
CALLMEBOT_APIKEY=

# Minutes entre deux alertes identiques (évite le spam)
ALERT_COOLDOWN_MINUTES=30

# Optionnel : jumelage par code au lieu du QR (même format)
# Utile sous Windows si le QR s'affiche mal dans le terminal
PAIRING_NUMBER=

# Transcription des vocaux (optionnel). Sinon Whisper tourne en local.
# GROQ_API_KEY=
# OPENAI_API_KEY=

