[Unit]
Description=WhatsApp Bot (commandes + transcription vocaux)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/whatsapp-bot
Environment=NODE_ENV=production
Environment=HOME=/home/ubuntu
ExecStart=/usr/bin/node /home/ubuntu/whatsapp-bot/src/index.js
Restart=always
RestartSec=15
TimeoutStartSec=180
StandardOutput=append:/home/ubuntu/whatsapp-bot/logs/bot.log
StandardError=append:/home/ubuntu/whatsapp-bot/logs/bot.log

[Install]
WantedBy=multi-user.target
