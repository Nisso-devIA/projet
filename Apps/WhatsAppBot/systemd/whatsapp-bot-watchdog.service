[Unit]
Description=WhatsApp Bot watchdog (restart if down)
After=network-online.target whatsapp-bot.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/whatsapp-bot
Environment=WHATSAPP_BOT_ROOT=/home/ubuntu/whatsapp-bot
ExecStart=/home/ubuntu/whatsapp-bot/tools/watchdog.sh
